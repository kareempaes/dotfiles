# Ghostty Configuration

# Primary Theme
# Name must match a bundled theme exactly; list them with: ghostty +list-themes
theme = Monokai Soda
# Option sends Alt so tmux M- bindings and minuet Alt chords work. "left" keeps right-Option for special characters.
macos-option-as-alt = true
# Open this file in Neovim. The stock open_config action always uses the macOS default app.
keybind = cmd+,=text:nvim ~/.config/ghostty/config\r
